#!/bin/bash
# WinAlign Pre-commit Hook - Enforce Code Organization Rules
# See docs/CODE_ORGANIZATION_RULES.md for details

set -e

# Configuration
MAX_SOURCE_LINES=500
MAX_HEADER_LINES=300
MAX_TEST_LINES=400

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

VIOLATIONS=0
WARNINGS=0

echo "🔍 Checking code organization rules..."
echo ""

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=AM)

# Check each file
for file in $STAGED_FILES; do
    # Skip if file doesn't exist (deleted)
    if [ ! -f "$file" ]; then
        continue
    fi

    # Only check source and header files
    if [[ ! "$file" =~ \.(cpp|cu|c|h|cuh|hpp)$ ]]; then
        continue
    fi

    # Count lines
    LINES=$(wc -l < "$file")

    # Determine limit based on file type
    if [[ "$file" =~ \.h$ ]] || [[ "$file" =~ \.cuh$ ]] || [[ "$file" =~ \.hpp$ ]]; then
        LIMIT=$MAX_HEADER_LINES
        TYPE="header"
    elif [[ "$file" =~ _test\.(cpp|cu)$ ]]; then
        LIMIT=$MAX_TEST_LINES
        TYPE="test"
    else
        LIMIT=$MAX_SOURCE_LINES
        TYPE="source"
    fi

    # Check if over limit
    if [ $LINES -gt $LIMIT ]; then
        echo -e "${RED}❌ BLOCKED${NC}: $file"
        echo -e "   Lines: ${RED}$LINES${NC} (limit: $LIMIT for $TYPE files)"
        echo -e "   Over by: $((LINES - LIMIT)) lines ($((100 * (LINES - LIMIT) / LIMIT))% over)"
        echo ""
        VIOLATIONS=$((VIOLATIONS + 1))
    # Warning if approaching limit (80% of limit)
    elif [ $LINES -gt $((LIMIT * 80 / 100)) ]; then
        echo -e "${YELLOW}⚠️  WARNING${NC}: $file"
        echo -e "   Lines: ${YELLOW}$LINES${NC} (limit: $LIMIT for $TYPE files)"
        echo -e "   Approaching limit: $((100 * LINES / LIMIT))% used"
        echo ""
        WARNINGS=$((WARNINGS + 1))
    fi
done

# Summary
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ $VIOLATIONS -gt 0 ]; then
    echo -e "${RED}❌ COMMIT BLOCKED${NC}"
    echo ""
    echo "  $VIOLATIONS file(s) exceed size limits"
    if [ $WARNINGS -gt 0 ]; then
        echo "  $WARNINGS file(s) approaching limits (>80%)"
    fi
    echo ""
    echo "  Please refactor before committing:"
    echo "  • Source files: max $MAX_SOURCE_LINES lines"
    echo "  • Header files: max $MAX_HEADER_LINES lines"
    echo "  • Test files: max $MAX_TEST_LINES lines"
    echo ""
    echo "  See docs/CODE_ORGANIZATION_RULES.md for guidance"
    echo "  See docs/REFACTORING_PLAN_PIPELINE.md for examples"
    echo ""
    echo "  To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify -m 'your message'"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    exit 1
elif [ $WARNINGS -gt 0 ]; then
    echo -e "${YELLOW}⚠️  WARNINGS DETECTED${NC}"
    echo ""
    echo "  $WARNINGS file(s) approaching size limits (>80%)"
    echo "  Consider refactoring soon to stay under limits"
    echo ""
    echo "  See docs/CODE_ORGANIZATION_RULES.md for guidance"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "${GREEN}✅ Proceeding with commit${NC}"
    echo ""
    exit 0
else
    echo -e "${GREEN}✅ All files within size limits${NC}"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    exit 0
fi
